# All keys are optional; the pipeline falls back to keyless sources without them.
# Tavily web search (https://tavily.com, free tier). Without it: keyless DuckDuckGo/Bing HTML search.
TAVILY_API_KEY=
# Composio Python SDK: full toolkit catalog + scripts/composio_first_call.py (https://platform.composio.dev).
# Without it: public composio.dev/toolkits pages by slug.
COMPOSIO_API_KEY=
# GitHub search for MCP repos in vendor orgs. Without it GitHub allows ~10 searches/min and a full run loses results.
# In PowerShell: $env:GITHUB_TOKEN = (gh auth token)
GITHUB_TOKEN=
